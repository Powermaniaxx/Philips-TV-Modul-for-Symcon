{
  "elements": [
    {
      "type": "Label",
      "caption": "Philips TV Steuerung – JointSpace API 6 (HTTPS/Digest)"
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Verbindung aktivieren"
    },
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "IP-Adresse oder Hostname des Fernsehers (ohne https://)"
    },
    {
      "type": "ValidationTextBox",
      "name": "Username",
      "caption": "Benutzername der bestehenden Kopplung"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "Passwort der bestehenden Kopplung"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "HTTPS-Port (Standard 1926)",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "PollInterval",
      "caption": "Statusabfrage bei eingeschaltetem TV (Sekunden)",
      "minimum": 5,
      "maximum": 300
    },
    {
      "type": "NumberSpinner",
      "name": "StandbyInterval",
      "caption": "Statusabfrage im Standby (Sekunden, 0 = pausieren)",
      "minimum": 0,
      "maximum": 3600
    },
    {
      "type": "SelectVariable",
      "name": "WakeSignal",
      "caption": "Optionales Aktivierungssignal"
    },
    {
      "type": "Label",
      "caption": "Bei Standby-Intervall 0 pausieren die Abfragen. Optional kann z. B. eine AVR-, Shield- oder eigene Statusvariable sie bei einem Wechsel auf aktiv fortsetzen (true, Ganzzahl 1, on oder awake). Ohne Auswahl ist kein Signal nötig. Das Signal sendet keinen Einschaltbefehl an den TV. Alternativ manuell aktualisieren oder Standby-Abfragen aktivieren."
    },
    {
      "type": "NumberSpinner",
      "name": "Timeout",
      "caption": "Zeitlimit je Anfrage (Millisekunden)",
      "minimum": 500,
      "maximum": 10000
    },
    {
      "type": "CheckBox",
      "name": "VerifyTLS",
      "caption": "TLS-Zertifikat prüfen (Philips verwendet meist ein selbstsigniertes Zertifikat)"
    },
    {
      "type": "Label",
      "caption": "Zugangsdaten bleiben in der lokalen Symcon-Konfiguration. Kein Python und kein Node-RED für diese Verbindung nötig. Für die Anzeige in der Haussteuerung zusätzlich Hausstatus ab 0.132 installieren und dort unter Wohnzimmer diese Philips-TV-Instanz auswählen."
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "Neue Kopplung: TV einschalten, IP-Adresse speichern, Kopplung starten und PIN vom TV bestätigen. Bestehende Zugangsdaten können weiterverwendet werden."
    },
    {
      "type": "Button",
      "caption": "Kopplung starten (PIN am TV anzeigen)",
      "onClick": "SVPTV_StartPairing($id);"
    },
    {
      "type": "PasswordTextBox",
      "name": "PairingPIN",
      "caption": "PIN vom Fernseher (wird nicht gespeichert)"
    },
    {
      "type": "Button",
      "caption": "TV-PIN bestätigen und Zugangsdaten speichern",
      "onClick": "SVPTV_CompletePairing($id, $PairingPIN);"
    },
    {
      "type": "Label",
      "name": "PairingDiagnostic",
      "caption": "TV-Kopplung: Noch keine Kopplung gestartet."
    },
    {
      "type": "Label",
      "name": "ConnectionDiagnostic",
      "caption": "Verbindungsdiagnose: Noch keine Anfrage protokolliert."
    },
    {
      "type": "Label",
      "name": "TransportDiagnostic",
      "caption": "Letzte HTTPS-Anfrage: Noch keine Anfrage protokolliert."
    },
    {
      "type": "Label",
      "name": "CommandDiagnostic",
      "caption": "Letzter Schaltversuch: Noch kein Schaltversuch protokolliert."
    },
    {
      "type": "Button",
      "caption": "Status aktualisieren / Verbindung prüfen",
      "onClick": "SVPTV_UpdateStatus($id);"
    },
    {
      "type": "Button",
      "caption": "Home-Menü am eingeschalteten TV testen",
      "onClick": "IPS_RequestAction($id, 'RemoteKey', 'Home');"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Verbindung aktiv"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Deaktiviert"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "IP-Adresse und Kopplungsdaten prüfen"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "TV nicht erreichbar oder Antwort ungültig"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "Anmeldung fehlgeschlagen – Kopplungsdaten prüfen"
    },
    {
      "code": 203,
      "icon": "error",
      "caption": "PHP-cURL fehlt"
    }
  ]
}
